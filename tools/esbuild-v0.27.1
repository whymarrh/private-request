#!/usr/bin/env bash

set -eu
set -o pipefail

declare -r version="0.27.1"
declare -r dir="$(cd "$(dirname "$0")" && pwd)"
declare -r platform="$(uname -ms)"
declare -r tgz="${dir}/esbuild-${version}.tgz"

trap 'rm -f "$tgz"' EXIT

case "$platform" in
  'Darwin arm64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/darwin-arm64/-/darwin-arm64-${version}.tgz"
    ;;
  'Darwin x86_64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/darwin-x64/-/darwin-x64-${version}.tgz"
    ;;
  'Linux arm64' | 'Linux aarch64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/linux-arm64/-/linux-arm64-${version}.tgz"
    ;;
  'Linux x86_64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/linux-x64/-/linux-x64-${version}.tgz"
    ;;
  'NetBSD amd64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/netbsd-x64/-/netbsd-x64-${version}.tgz"
    ;;
  'OpenBSD arm64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/openbsd-arm64/-/openbsd-arm64-${version}.tgz"
    ;;
  'OpenBSD amd64')
    curl -sSLfo "$tgz" "https://registry.npmjs.org/@esbuild/openbsd-x64/-/openbsd-x64-${version}.tgz"
    ;;
  *)
    printf '%s\n' "error: Unsupported platform: $platform" >&2
    exit 1
    ;;
esac

tar -xzf "$tgz" -C "$dir" --strip-components=2 package/bin/esbuild
