{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "enabled": true
  },
  "files": {
    "includes": ["**/*.ts", "!**/*.d.ts"]
  }
}
